{
  "name": "@evo/data-platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "node --env-file=../.env.local migrate.mjs",
    "export": "node export.mjs",
    "import": "node --env-file=../.env.local import.mjs",
    "test": "node --test page-dependencies.test.mjs",
    "test:native": "node --env-file=../.env.local verify-page-model.mjs",
    "graph:index": "node --env-file=../.env.local index-page-dependencies.mjs",
    "graph:verify": "node --env-file=../.env.local verify-page-index.mjs"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "pg": "8.23.1",
    "pg-copy-streams": "7.0.0",
    "tar-stream": "3.2.2",
    "yaml": "2.8.3"
  }
}
