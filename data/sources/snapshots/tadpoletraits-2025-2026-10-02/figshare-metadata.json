{"url_public_html": "https://figshare.com/articles/dataset/TadpoleTraits/28069802/4", "files": [{"id": 53849837, "name": "Tadpole data 2025.4.21.xlsx", "size": 2206578, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/53849837", "supplied_md5": "dc56aef23cec138fb1931e64cd237257", "computed_md5": "dc56aef23cec138fb1931e64cd237257", "mimetype": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"}], "folder_structure": {}, "authors": [{"id": 13000812, "full_name": "Zhou", "first_name": "", "last_name": "Zhou", "is_active": true, "url_name": "Zhou", "orcid_id": "0000-0001-9023-6663"}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/TadpoleTraits/28069802", "download_disabled": false, "description": "<table><tr><td><p dir=\"ltr\">Functional diversity is an important dimension of biodiversity. In animals, most species have complex life cycles, that the same species can display great differences in traits and ecological roles across different life history stages. Consequently, the patterns and driving factors of functional diversity can vary considerably among the different life stages. However, research on stages other than adults is rare, with data scarcity being a potential reason. The order Anura of Amphibian is a highly diverse group of terrestrial vertebrates, comprising more than 7,800 species. Anurans have complex life cycles, and our knowledge about functional traits of the larval stage is extremely limited. To fill this gap, we collected morphological traits of global tadpoles and compiled a database covered 1,993 species to facilitate future studies. This database can help us gain a more comprehensive understanding on anuran biodiversity. Additionally, it offers a valuable tool for testing ecological and evolutionary hypotheses related to complex life cycles in animals.</p></td></tr></table><p></p>", "funding": null, "funding_list": [], "version": 4, "status": "public", "size": 2206578, "created_date": "2025-04-21T08:13:22Z", "modified_date": "2025-12-05T08:29:34Z", "is_public": true, "is_confidential": false, "is_metadata_record": false, "confidential_reason": "", "metadata_reason": "", "license": {"value": 1, "name": "CC BY 4.0", "url": "https://creativecommons.org/licenses/by/4.0/"}, "tags": ["Tadpoles", "biodiversity", "functional traits", "developmental stages", "conservation", "morphology"], "keywords": ["Tadpoles", "biodiversity", "functional traits", "developmental stages", "conservation", "morphology"], "categories": [{"id": 24439, "title": "Vertebrate biology", "parent_id": 24397, "path": "/24130/24397/24439", "source_id": "310914", "taxonomy_id": 100}, {"id": 24238, "title": "Ecology not elsewhere classified", "parent_id": 24211, "path": "/24130/24211/24238", "source_id": "310399", "taxonomy_id": 100}], "references": [], "has_linked_file": false, "citation": "Zhou (2024). TadpoleTraits. figshare. Dataset. https://doi.org/10.6084/m9.figshare.28069802.v4", "related_materials": [], "is_embargoed": false, "embargo_date": null, "embargo_type": null, "embargo_title": "", "embargo_reason": "", "embargo_options": [], "id": 28069802, "title": "TadpoleTraits", "doi": "10.6084/m9.figshare.28069802.v4", "handle": "", "url": "https://api.figshare.com/v2/articles/28069802", "published_date": "2025-04-21T08:13:22Z", "thumb": "", "defined_type": 3, "defined_type_name": "dataset", "group_id": null, "url_private_api": "https://api.figshare.com/v2/account/articles/28069802", "url_public_api": "https://api.figshare.com/v2/articles/28069802", "url_private_html": "https://figshare.com/account/articles/28069802", "timeline": {"posted": "2025-04-21T08:13:22", "firstOnline": "2024-12-20"}, "resource_title": null, "resource_doi": null}