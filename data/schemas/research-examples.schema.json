{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/research-examples.schema.json",
  "title": "Evo Atlas package research examples",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "examples"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "description", "route", "entityIds", "claimIds", "evidenceStatus", "limitations"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "type": { "enum": ["explorer-preset", "comparison", "guided-story"] },
          "title": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "zh"],
            "properties": { "en": { "type": "string", "minLength": 3 }, "zh": { "type": "string", "minLength": 2 } }
          },
          "description": {
            "type": "object",
            "additionalProperties": false,
            "required": ["en", "zh"],
            "properties": { "en": { "type": "string", "minLength": 20 }, "zh": { "type": "string", "minLength": 10 } }
          },
          "route": { "type": "string", "pattern": "^#/" },
          "entityIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "claimIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "evidenceStatus": { "enum": ["scaffold", "available-with-limitations"] },
          "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } }
        }
      }
    }
  }
}
