{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/range-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "entityId", "rangeKind", "taxonomicConcept", "geographicScope", "olderMa", "youngerMa", "status", "uncertainty", "evidenceBasis", "confidence", "claimIds", "referenceLocators", "reviewStatus"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "entityId": { "type": "string", "minLength": 1 },
    "rangeKind": { "enum": ["global-composite", "taxon-range", "dispersal-window", "regional-last-appearance-window"] },
    "taxonomicConcept": { "type": "string", "minLength": 1 },
    "geographicScope": { "type": "string", "minLength": 1 },
    "olderMa": { "type": "number", "minimum": 0, "maximum": 4567 },
    "youngerMa": { "type": "number", "minimum": 0, "maximum": 4567 },
    "status": { "enum": ["available", "unknown", "unavailable", "unmapped", "withheld-pending-provenance"] },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["olderMa", "youngerMa", "note"],
      "properties": {
        "olderMa": { "type": ["number", "null"], "minimum": 0 },
        "youngerMa": { "type": ["number", "null"], "minimum": 0 },
        "note": { "type": "string", "minLength": 10 }
      }
    },
    "evidenceBasis": { "type": "string", "minLength": 20 },
    "confidence": { "enum": ["high", "medium", "low", "contested"] },
    "claimIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^claim:" } },
    "referenceLocators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["referenceId", "locator"],
        "properties": {
          "referenceId": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 }
        }
      }
    },
    "reviewStatus": { "enum": ["not-reviewed", "automated-audit-passed", "expert-reviewed"] }
  }
}
