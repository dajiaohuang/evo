{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/range-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "entityId", "olderMa", "youngerMa", "status", "basis", "confidence", "referenceIds"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "entityId": { "type": "string", "minLength": 1 },
    "olderMa": { "type": "number", "minimum": 0, "maximum": 4567 },
    "youngerMa": { "type": "number", "minimum": 0, "maximum": 4567 },
    "status": { "enum": ["available", "unknown", "unavailable", "unmapped", "withheld-pending-provenance"] },
    "basis": { "type": "string", "minLength": 20 },
    "confidence": { "enum": ["high", "medium", "low", "contested"] },
    "referenceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
