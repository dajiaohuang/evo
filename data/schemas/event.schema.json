{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "titleZh", "category", "startAge", "endAge", "regions", "clades", "summary", "evidence", "uncertainties", "confidence", "referenceIds"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "titleZh": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "startAge": { "type": "number", "minimum": 0, "maximum": 4567 },
    "endAge": { "type": "number", "minimum": 0, "maximum": 4567 },
    "regions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "clades": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "summary": { "type": "string", "minLength": 20 },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "uncertainties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "confidence": { "enum": ["high", "medium", "low", "contested"] },
    "referenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
