{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "titleZh", "category", "startAge", "endAge", "regions", "clades", "summary", "evidenceItems", "uncertaintyItems", "claimIds"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "titleZh": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "startAge": { "type": "number", "minimum": 0, "maximum": 4567 },
    "endAge": { "type": "number", "minimum": 0, "maximum": 4567 },
    "regions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "clades": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "summary": { "type": "string", "minLength": 20 },
    "evidenceItems": { "$ref": "#/$defs/evidenceItems" },
    "uncertaintyItems": { "$ref": "#/$defs/evidenceItems" },
    "claimIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^claim:event:" } }
  },
  "$defs": {
    "evidenceItems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statement", "relation", "claimIds", "referenceLinks"],
        "properties": {
          "statement": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["supports", "contradicts", "contextualizes"] },
          "claimIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^claim:event:" } },
          "referenceLinks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["referenceId", "relation"],
              "properties": {
                "referenceId": { "type": "string", "minLength": 1 },
                "relation": { "enum": ["supports", "contradicts", "contextualizes"] },
                "pages": { "type": "string", "minLength": 1 },
                "figure": { "type": "string", "minLength": 1 },
                "quoteLocator": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
