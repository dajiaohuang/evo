{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/claim.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subjectId", "claimType", "statement", "confidence", "referenceLinks"],
  "properties": {
    "id": { "type": "string", "pattern": "^claim:(?:event|taxon):" },
    "subjectId": { "type": "string", "pattern": "^(?:event|taxon):" },
    "claimType": { "enum": ["taxonomy", "topology", "divergence-time", "fossil-range", "biogeography", "morphology", "ecology", "event-mechanism"] },
    "statement": { "type": "string", "minLength": 20 },
    "confidence": { "enum": ["high", "medium", "low", "contested"] },
    "referenceLinks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["referenceId"],
        "properties": {
          "referenceId": { "type": "string", "minLength": 1 },
          "pages": { "type": "string", "minLength": 1 },
          "figure": { "type": "string", "minLength": 1 },
          "quoteLocator": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
