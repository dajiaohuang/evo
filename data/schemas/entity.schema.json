{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/entity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "entityKind", "contentLevel", "externalResolutionStatus", "packageId", "parentId", "parentRelationshipKind", "names", "synonyms", "rank", "definition", "compositionScope", "temporalRange", "externalIds", "referenceIds", "evidenceStatus", "limitations", "dataAvailability", "review", "version"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "entityKind": { "enum": ["taxon", "navigation-group", "historical-grade", "informal-group", "hypothesis-node"] },
    "contentLevel": { "enum": ["registry-only", "dossier", "full-profile"] },
    "externalResolutionStatus": { "enum": ["resolved-exact", "resolved-synonym", "resolved-rank-variant", "resolved-broader", "resolved-narrower", "ambiguous", "not-found", "not-applicable"] },
    "packageId": { "type": "string", "minLength": 1 },
    "parentId": { "type": ["string", "null"] },
    "parentRelationshipKind": { "type": ["string", "null"], "enum": ["taxonomic-parent", "navigation-parent", "display-grouping", "historical-grade-membership", "cross-package-reference", null] },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scientific", "en", "zh"],
      "properties": {
        "scientific": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 }
      }
    },
    "synonyms": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "rank": { "type": "string", "minLength": 1 },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": { "type": "string", "minLength": 20 },
        "zh": { "type": "string", "minLength": 10 }
      }
    },
    "compositionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includesSelf", "descendantEntityIds"],
      "properties": {
        "includesSelf": { "const": true },
        "descendantEntityIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "temporalRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["olderMa", "youngerMa", "status", "basis", "evidenceLevel", "provisional"],
      "properties": {
        "olderMa": { "type": "number", "minimum": 0, "maximum": 4567 },
        "youngerMa": { "type": "number", "minimum": 0, "maximum": 4567 },
        "status": { "enum": ["available", "unknown", "unavailable", "unmapped", "withheld-pending-provenance"] },
        "basis": { "type": "string", "minLength": 20 },
        "evidenceLevel": { "enum": ["legacy-display", "database-derived", "literature-synthesized", "expert-reviewed"] },
        "provisional": { "type": "boolean" }
      }
    },
    "externalIds": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "referenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "evidenceStatus": { "enum": ["strong", "moderate", "contextual", "contested"] },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "dataAvailability": {
      "type": "object",
      "additionalProperties": { "enum": ["available", "unknown", "not-applicable", "unavailable", "unmapped", "withheld-pending-provenance"] }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedBy", "reviewedAt", "scope", "scientificPeerReview", "reviewers"],
      "properties": {
        "status": { "enum": ["pending", "automated-audit-passed", "expert-reviewed"] },
        "reviewedBy": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "scientificPeerReview": { "type": "boolean" },
        "reviewers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "identityType", "expertise", "reviewScope", "conflictOfInterest"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "identityType": { "enum": ["automated-system", "human"] },
              "orcid": { "type": ["string", "null"], "pattern": "^https://orcid.org/[0-9X-]+$" },
              "expertise": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "reviewScope": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "conflictOfInterest": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "version": { "type": "string", "minLength": 1 }
  }
}
