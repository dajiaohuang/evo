{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/entity.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "entityType", "packageId", "parentId", "names", "synonyms", "rank", "definition", "compositionScope", "temporalRange", "externalIds", "referenceIds", "evidenceStatus", "limitations", "dataAvailability", "review", "version"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "entityType": { "enum": ["taxon-profile", "navigation-dossier", "informal-group-dossier", "phylogeny-node"] },
    "packageId": { "type": "string", "minLength": 1 },
    "parentId": { "type": ["string", "null"] },
    "names": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scientific", "en", "zh"],
      "properties": {
        "scientific": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 },
        "zh": { "type": "string", "minLength": 1 }
      }
    },
    "synonyms": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "rank": { "type": "string", "minLength": 1 },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": { "type": "string", "minLength": 20 },
        "zh": { "type": "string", "minLength": 10 }
      }
    },
    "compositionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includesSelf", "descendantEntityIds"],
      "properties": {
        "includesSelf": { "const": true },
        "descendantEntityIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "temporalRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["olderMa", "youngerMa", "status", "basis"],
      "properties": {
        "olderMa": { "type": "number", "minimum": 0, "maximum": 4567 },
        "youngerMa": { "type": "number", "minimum": 0, "maximum": 4567 },
        "status": { "enum": ["available", "unknown", "unavailable", "unmapped", "withheld-pending-provenance"] },
        "basis": { "type": "string", "minLength": 20 }
      }
    },
    "externalIds": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "referenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "evidenceStatus": { "enum": ["strong", "moderate", "contextual", "contested"] },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "dataAvailability": {
      "type": "object",
      "additionalProperties": { "enum": ["available", "unknown", "not-applicable", "unavailable", "unmapped", "withheld-pending-provenance"] }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewedBy", "reviewedAt", "scope", "scientificPeerReview"],
      "properties": {
        "status": { "enum": ["pending", "automated-audit-passed", "expert-reviewed"] },
        "reviewedBy": { "type": "string", "minLength": 1 },
        "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "scientificPeerReview": { "type": "boolean" }
      }
    },
    "version": { "type": "string", "minLength": 1 }
  }
}
