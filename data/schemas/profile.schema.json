{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "treeNodeId", "pbdbTaxonId", "scientificName", "commonName", "commonNameZh", "rank", "parentName", "extinct", "firstAppearance", "lastAppearance", "rangeEvidenceLevel", "rangeReviewStatus", "rangeProvisional", "geography", "overview", "ecology", "traits", "evidenceSummary", "confidence", "referenceIds"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "treeNodeId": { "type": "string", "minLength": 1 },
    "pbdbTaxonId": { "type": "string", "pattern": "^txn:[0-9]+$" },
    "scientificName": { "type": "string", "minLength": 1 },
    "commonName": { "type": "string", "minLength": 1 },
    "commonNameZh": { "type": "string", "minLength": 1 },
    "rank": { "type": "string", "minLength": 1 },
    "parentName": { "type": "string", "minLength": 1 },
    "extinct": { "type": "boolean" },
    "firstAppearance": { "type": "number", "minimum": 0, "maximum": 4567 },
    "lastAppearance": { "type": "number", "minimum": 0, "maximum": 4567 },
    "rangeEvidenceLevel": { "enum": ["legacy-display", "database-derived", "literature-synthesized", "withheld-no-range-evidence", "expert-reviewed"] },
    "rangeReviewStatus": { "enum": ["not-reviewed", "automated-audit-passed", "expert-reviewed"] },
    "rangeProvisional": { "type": "boolean" },
    "geography": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "regionalRanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "region", "rangeKind", "olderMa", "youngerMa", "basis", "confidence", "evidenceLevel", "provisional", "referenceIds"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 },
          "rangeKind": { "enum": ["taxon-range", "dispersal-window", "regional-last-appearance-window"] },
          "olderMa": { "type": "number", "minimum": 0, "maximum": 4567 },
          "youngerMa": { "type": "number", "minimum": 0, "maximum": 4567 },
          "basis": { "type": "string", "minLength": 20 },
          "confidence": { "enum": ["high", "medium", "low", "contested"] },
          "evidenceLevel": { "enum": ["legacy-display", "database-derived", "literature-synthesized", "withheld-no-range-evidence", "expert-reviewed"] },
          "provisional": { "type": "boolean" },
          "referenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "overview": { "type": "string", "minLength": 20 },
    "ecology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diet", "habitat", "locomotion", "bodySize", "guild"],
      "properties": {
        "diet": { "type": "string", "minLength": 1 },
        "habitat": { "type": "string", "minLength": 1 },
        "locomotion": { "type": "string", "minLength": 1 },
        "bodySize": { "type": "string", "minLength": 1 },
        "guild": { "type": "string", "minLength": 1 }
      }
    },
    "traits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidenceSummary": { "type": "string", "minLength": 20 },
    "confidence": { "enum": ["high", "medium", "low", "contested"] },
    "referenceIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
