{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "treeNodeId",
    "pbdbTaxonId",
    "scientificName",
    "commonName",
    "commonNameZh",
    "rank",
    "parentName",
    "extinct",
    "firstAppearance",
    "lastAppearance",
    "rangeEvidenceLevel",
    "rangeProvisional",
    "geography",
    "overview",
    "ecology",
    "traits",
    "evidenceSummary",
    "confidence",
    "referenceIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "treeNodeId": {
      "type": "string",
      "minLength": 1
    },
    "pbdbTaxonId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^txn:[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scientificName": {
      "type": "string",
      "minLength": 1
    },
    "commonName": {
      "type": "string",
      "minLength": 1
    },
    "commonNameZh": {
      "type": "string",
      "minLength": 1
    },
    "rank": {
      "type": "string",
      "minLength": 1
    },
    "parentName": {
      "type": "string",
      "minLength": 1
    },
    "extinct": {
      "type": "boolean"
    },
    "firstAppearance": {
      "type": "number",
      "minimum": 0,
      "maximum": 4567
    },
    "lastAppearance": {
      "type": "number",
      "minimum": 0,
      "maximum": 4567
    },
    "rangeEvidenceLevel": {
      "enum": [
        "legacy-display",
        "database-derived",
        "literature-synthesized",
        "withheld-no-range-evidence"
      ]
    },
    "rangeProvisional": {
      "type": "boolean"
    },
    "geography": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "regionalRanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "region",
          "rangeKind",
          "olderMa",
          "youngerMa",
          "basis",
          "confidence",
          "evidenceLevel",
          "provisional",
          "referenceIds"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string",
            "minLength": 1
          },
          "rangeKind": {
            "enum": [
              "taxon-range",
              "dispersal-window",
              "regional-last-appearance-window"
            ]
          },
          "olderMa": {
            "type": "number",
            "minimum": 0,
            "maximum": 4567
          },
          "youngerMa": {
            "type": "number",
            "minimum": 0,
            "maximum": 4567
          },
          "basis": {
            "type": "string",
            "minLength": 20
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "contested"
            ]
          },
          "evidenceLevel": {
            "enum": [
              "legacy-display",
              "database-derived",
              "literature-synthesized",
              "withheld-no-range-evidence"
            ]
          },
          "provisional": {
            "type": "boolean"
          },
          "referenceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "overview": {
      "type": "string",
      "minLength": 20
    },
    "ecology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "diet": {
          "type": "string",
          "minLength": 1
        },
        "habitat": {
          "type": "string",
          "minLength": 1
        },
        "locomotion": {
          "type": "string",
          "minLength": 1
        },
        "bodySize": {
          "type": "string",
          "minLength": 1
        },
        "guild": {
          "type": "string",
          "minLength": 1
        },
        "dietZh": {
          "type": "string",
          "minLength": 1
        },
        "habitatZh": {
          "type": "string",
          "minLength": 1
        },
        "locomotionZh": {
          "type": "string",
          "minLength": 1
        },
        "bodySizeZh": {
          "type": "string",
          "minLength": 1
        },
        "guildZh": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "traits": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "traitsAssessmentStatus": {
      "enum": [
        "assessed",
        "not-assessed"
      ]
    },
    "evidenceSummary": {
      "type": "string",
      "minLength": 20
    },
    "readerSections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "$ref": "#/$defs/bilingualText"
          },
          "text": {
            "$ref": "#/$defs/bilingualText"
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low",
              "contested"
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "claimIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^claim:"
            }
          }
        }
      }
    },
    "readerSources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "scope"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "$ref": "#/$defs/bilingualText"
              }
            ]
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "$ref": "#/$defs/bilingualText"
          },
          "referenceId": {
            "type": "string",
            "minLength": 1
          },
          "sourceFileSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "doi": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "readingUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "licenseUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "publishedAt": {
            "type": "string",
            "minLength": 1
          },
          "accessedAt": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "licenseVersion": {
            "type": "string",
            "minLength": 1
          },
          "licenseAppliesTo": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "string",
            "minLength": 1
          },
          "rightsHolder": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "readerRelatedPages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "targetId",
          "label",
          "context"
        ],
        "properties": {
          "targetId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "$ref": "#/$defs/bilingualText"
          },
          "context": {
            "$ref": "#/$defs/bilingualText"
          }
        }
      }
    },
    "readerLimitations": {
      "$ref": "#/$defs/bilingualText"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "contested"
      ]
    },
    "referenceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overviewZh": {
      "type": "string",
      "minLength": 1
    },
    "evidenceSummaryZh": {
      "type": "string",
      "minLength": 1
    },
    "traitsZh": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "bilingualText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "traits": {
            "type": "array",
            "maxItems": 0
          }
        },
        "required": [
          "traits"
        ]
      },
      "then": {
        "required": [
          "traitsAssessmentStatus"
        ],
        "properties": {
          "traitsAssessmentStatus": {
            "const": "not-assessed"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "traitsAssessmentStatus": {
            "const": "not-assessed"
          }
        },
        "required": [
          "traitsAssessmentStatus"
        ]
      },
      "then": {
        "properties": {
          "traits": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
