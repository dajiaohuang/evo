{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["subjectId", "status", "reviewedBy", "reviewedAt", "scope", "scientificPeerReview", "version"],
  "properties": {
    "subjectId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "automated-audit-passed", "expert-reviewed"] },
    "reviewedBy": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "scientificPeerReview": { "type": "boolean" },
    "version": { "type": "string", "minLength": 1 }
  }
}
