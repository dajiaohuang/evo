{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/package-review.schema.json",
  "title": "Evo Atlas package maintainer review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subjectId",
    "status",
    "reviewedBy",
    "reviewedAt",
    "reviewedCommit",
    "contentDigest",
    "chatgptAssisted",
    "scope",
    "openIssues"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "subjectId": { "type": "string", "pattern": "^package:[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["not-reviewed", "in-review", "reviewed-with-caveats", "reviewed"] },
    "reviewedBy": { "type": ["string", "null"], "minLength": 1 },
    "reviewedAt": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "reviewedCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
    "contentDigest": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" },
    "chatgptAssisted": { "type": "boolean" },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "openIssues": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "not-reviewed" } } },
      "then": {
        "properties": {
          "reviewedBy": { "const": null },
          "reviewedAt": { "const": null },
          "reviewedCommit": { "const": null },
          "contentDigest": { "const": null },
          "chatgptAssisted": { "const": false }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "in-review" } } },
      "then": {
        "properties": {
          "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["reviewed-with-caveats", "reviewed"] } } },
      "then": {
        "properties": {
          "reviewedBy": { "type": "string", "minLength": 1 },
          "reviewedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "reviewedCommit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "reviewed-with-caveats" } } },
      "then": { "properties": { "openIssues": { "type": "array", "minItems": 1 } } }
    }
  ]
}
