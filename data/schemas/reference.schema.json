{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/reference.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "authors",
    "type",
    "sourceRole",
    "fitnessFor"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "authorsComplete": {
      "type": "boolean"
    },
    "authorsStatus": {
      "enum": [
        "recorded",
        "incomplete-verbatim",
        "unresolved",
        "complete-verbatim",
        "verified-from-primary-front-page"
      ]
    },
    "authorsVerbatim": {
      "type": "string",
      "minLength": 1
    },
    "titleTranslations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "zh": {
          "type": "string"
        }
      }
    },
    "publishedYear": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2100
    },
    "publishedAt": {
      "type": "string",
      "minLength": 1
    },
    "accessedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "pages": {
      "type": "string",
      "minLength": 1
    },
    "datasetSnapshot": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "sourceRole": {
      "enum": [
        "primary-study",
        "systematic-review",
        "taxonomic-database",
        "occurrence-database",
        "museum-overview",
        "documentation",
        "standard",
        "unclassified",
        "assessment",
        "taxonomic-assessment",
        "institutional-species-account",
        "anatomical-redescription",
        "author-correction",
        "bone-histology-and-growth-study",
        "comparative-anatomy",
        "comparative-reassessment",
        "comparative-response",
        "cranial-redescription",
        "developmental-analysis",
        "holotype-osteology-and-functional-interpretation",
        "later-dentary-abstract",
        "national-conservation-assessment",
        "nomenclatural-correction",
        "original-anatomical-description",
        "original-description",
        "original-species-description",
        "phylogenetic-reassessment",
        "primary",
        "primary-taxonomic-description",
        "referred-specimen-osteology",
        "secondary-species-compilation",
        "specimen-anatomy-and-phylogeny",
        "specimen-description",
        "specimen-redescription",
        "specimen-redescription-and-phylogeny",
        "taxonomic-literature-review",
        "taxonomic-review",
        "taxonomic-revision"
      ]
    },
    "fitnessFor": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "enum": [
          "taxonomy",
          "evolution",
          "topology",
          "range",
          "morphology",
          "ecology",
          "biogeography",
          "event-mechanism",
          "occurrence",
          "paleogeography",
          "geochronology",
          "methods",
          "conservation-status",
          "population-trends",
          "climate-threats",
          "local-occurrence",
          "conservation-context",
          "genetics",
          "current-taxonomic-treatment",
          "version-change-audit",
          "phylogeography",
          "population-monitoring",
          "behavior",
          "distribution",
          "habitat",
          "threats",
          "diet",
          "genomics",
          "population-structure",
          "development",
          "health",
          "lifeHistory",
          "appearance",
          "assessment-uncertainty",
          "comparative-size-estimate",
          "comparative-wingspan-estimate",
          "dated-national-assessment",
          "dated-phylogenetic-treatment",
          "explicit-data-gaps",
          "feeding-hypotheses",
          "field-methods",
          "geological-context",
          "historical-habitat-summary",
          "historical-morphology-summary",
          "holotype-anatomy",
          "holotype-description",
          "nomenclature",
          "palaeobiology",
          "phylogenetic-analyses",
          "phylogeny",
          "specimen-preservation",
          "stratigraphic-uncertainty"
        ]
      }
    },
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "doi": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string",
      "minLength": 1
    },
    "metadataStatus": {
      "type": "string",
      "minLength": 1
    },
    "metadataVariants": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "importedCitationMetadata": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifactSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dateStatus": {
      "enum": [
        "unresolved-in-source-metadata"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "journal": {
      "type": "string",
      "minLength": 1
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1
    },
    "publicationDateBasis": {
      "type": "string",
      "minLength": 1
    },
    "articleNumber": {
      "type": "string",
      "minLength": 1
    },
    "authorNameBasis": {
      "type": "string",
      "minLength": 1
    },
    "licenseEvidenceUrl": {
      "type": "string",
      "minLength": 1
    },
    "volume": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "issue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "publishedOnline": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "firstPublishedOnlineAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "publicationMonth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "year": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2100
    },
    "publicationDatePrecision": {
      "enum": [
        "year",
        "month",
        "day"
      ]
    },
    "publishedPrintDateParts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "importedMetadataVariants": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "metadataCorrection": {
      "type": "object",
      "required": [
        "date",
        "reason",
        "metadataSource"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "metadataSource": {
          "type": "string",
          "pattern": "^https://"
        },
        "previousDoi": {
          "type": "string",
          "minLength": 1
        },
        "correctedDoi": {
          "type": "string",
          "minLength": 1
        },
        "authorNameBoundary": {
          "type": "string",
          "minLength": 1
        },
        "scientificBoundary": {
          "type": "string",
          "minLength": 1
        },
        "retainedImportedMetadataVariant": {
          "type": "integer",
          "minimum": 0
        },
        "correctedImportedMetadataVariant": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
