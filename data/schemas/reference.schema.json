{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/reference.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "authors", "type", "url", "sourceRole", "fitnessFor", "metadataAssignment"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "authors": { "type": "string", "minLength": 1 },
    "publishedYear": { "type": "integer", "minimum": 1600, "maximum": 2100 },
    "accessedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "version": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "pages": { "type": "string", "minLength": 1 },
    "datasetSnapshot": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "sourceRole": { "enum": ["primary-study", "systematic-review", "taxonomic-database", "occurrence-database", "museum-overview", "documentation", "standard"] },
    "fitnessFor": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["taxonomy", "topology", "range", "morphology", "ecology", "biogeography", "event-mechanism", "occurrence", "paleogeography", "geochronology", "methods"] }
    },
    "metadataAssignment": { "enum": ["automated", "curator-reviewed"] },
    "url": { "type": "string", "pattern": "^https://" },
    "doi": { "type": "string", "minLength": 1 },
    "note": { "type": "string", "minLength": 1 }
  }
}
