{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/reference.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "authors", "type", "sourceRole", "fitnessFor", "metadataAssignment"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "authors": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "items": { "type": "string", "minLength": 1 } }] },
    "authorsComplete": { "type": "boolean" },
    "authorsStatus": { "enum": ["recorded", "incomplete-verbatim", "unresolved"] },
    "authorsVerbatim": { "type": "string", "minLength": 1 },
    "titleTranslations": { "type": "object", "additionalProperties": false, "properties": { "en": { "type": "string" }, "zh": { "type": "string" } } },
    "publishedYear": { "type": "integer", "minimum": 1, "maximum": 2100 },
    "publishedAt": { "type": "string", "minLength": 1 },
    "accessedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "version": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "pages": { "type": "string", "minLength": 1 },
    "datasetSnapshot": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "sourceRole": { "enum": ["primary-study", "systematic-review", "taxonomic-database", "occurrence-database", "museum-overview", "documentation", "standard", "unclassified"] },
    "fitnessFor": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": { "enum": ["taxonomy", "evolution", "topology", "range", "morphology", "ecology", "biogeography", "event-mechanism", "occurrence", "paleogeography", "geochronology", "methods"] }
    },
    "metadataAssignment": { "enum": ["automated", "curator-reviewed"] },
    "url": { "type": "string", "pattern": "^https://" },
    "doi": { "type": "string", "minLength": 1 },
    "note": { "type": "string", "minLength": 1 },
    "metadataStatus": { "type": "string", "minLength": 1 },
    "importedSourceMetadata": { "type": "array", "items": { "type": "object" } },
    "importedCitationMetadata": { "type": "array", "items": { "type": "object" } },
    "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
