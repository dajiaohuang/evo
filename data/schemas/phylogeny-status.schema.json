{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/phylogeny-status.schema.json",
  "title": "Evo Atlas package phylogeny status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "status", "topologyPath", "scopeEntityIds", "statement", "limitations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["available", "unmapped", "not-applicable"] },
    "topologyPath": { "type": ["string", "null"], "minLength": 1 },
    "scopeEntityIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": { "type": "string", "minLength": 20 },
        "zh": { "type": "string", "minLength": 10 }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "available" } } },
      "then": { "properties": { "topologyPath": { "type": "string", "minLength": 1 } } }
    },
    {
      "if": { "properties": { "status": { "enum": ["unmapped", "not-applicable"] } } },
      "then": { "properties": { "topologyPath": { "const": null } } }
    }
  ]
}
