{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/package.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "titleZh", "conceptScope", "rootEntityIds", "entityIds", "canonicalSources", "platformMaturity", "scientificMaturity", "automatedReviewStatus", "reviewStatus", "limitations"],
  "properties": {
    "schemaVersion": { "const": 5 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "titleZh": { "type": "string", "minLength": 1 },
    "conceptScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": { "type": "string", "minLength": 20 },
        "zh": { "type": "string", "minLength": 10 }
      }
    },
    "rootEntityIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "entityIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "canonicalSources": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
    "platformMaturity": { "enum": ["generated", "validated", "published"] },
    "scientificMaturity": { "enum": ["generated-scaffold", "structured", "source-linked", "curated-draft", "published"] },
    "automatedReviewStatus": { "enum": ["pending", "passed", "failed"] },
    "reviewStatus": { "enum": ["not-reviewed", "in-review", "reviewed-with-caveats", "reviewed"] },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } }
  }
}
