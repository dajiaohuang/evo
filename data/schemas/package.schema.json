{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dajiaohuang.github.io/evo/schemas/package.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "titleZh", "rootEntityIds", "entityIds", "canonicalSources", "maturity", "reviewStatus", "limitations"],
  "properties": {
    "schemaVersion": { "const": 3 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "titleZh": { "type": "string", "minLength": 1 },
    "rootEntityIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "entityIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "canonicalSources": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
    "maturity": { "enum": ["core", "gold-v2"] },
    "reviewStatus": { "enum": ["pending", "automated-audit-passed", "expert-reviewed"] },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } }
  }
}
